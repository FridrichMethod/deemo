# Auto detect text files and perform LF normalization
* text=auto
*.html linguist-language=javascript

# Preserve downloaded media bytes exactly, including PDFs that look textual.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.ttf binary
*.ico binary
*.mp3 binary

# Never convert line endings of files whose exact bytes are pinned, whatever core.autocrlf or
# core.eol say: inherited files in data/legacy-inventory.json and every asset (manifests record
# their SHA-256). Checked by tests/test_line_endings.py.
/LICENSE -text
/licenses/*.txt -text
/src/vendor/** -text
/scripts/legacy/*.py -text
/assets/** -text
